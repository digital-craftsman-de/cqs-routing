{
  "name": "digital-craftsman/cqs-routing",
  "description": "Build Symfony endpoints from typed commands, queries and handlers instead of fat controllers. Request decoding, DTO construction, validation, transactions and responses are handled by reusable components.",
  "type": "symfony-bundle",
  "require": {
    "php": "8.5.*|8.6.*",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/serializer": "^7.4|^8.0"
  },
  "require-dev": {
    "digital-craftsman/ids": "^2.5",
    "digital-craftsman/self-aware-normalizers": "^1.4",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^13.4",
    "symfony/property-access": "^7.4|^8.0",
    "symfony/property-info": "^7.4|^8.0",
    "symfony/yaml": "^7.4|^8.0",
    "vimeo/psalm": "^6.20"
  },
  "autoload": {
    "psr-4": {
      "DigitalCraftsman\\CQSRouting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DigitalCraftsman\\CQSRouting\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Kolb",
      "email": "info@digital-craftsman.de"
    }
  ],
  "config": {
    "sort-packages": true
  }
}
